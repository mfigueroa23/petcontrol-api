# Copiar a .env y completar los valores. El archivo .env no se versiona.

# Conexión a PostgreSQL (SDD 6.4). En Local se usa una base dedicada con un usuario propio
# dentro del contenedor Docker de PostgreSQL 17.
DATABASE_URL="postgresql://petcontrol:<password>@localhost:5432/petcontrol?schema=public"

# Base temporal que usa `prisma migrate dev` para detectar cambios. Solo en Local.
SHADOW_DATABASE_URL="postgresql://petcontrol:<password>@localhost:5432/petcontrol_shadow?schema=public"
